    {
      "parameters": {
        "jsCode": "// Analisa e normaliza a resposta da OpenAI\nconst inputData = $input.first().json;\n\n// Tenta extrair o sentimento da resposta da OpenAI\nlet sentimento = '';\n\n// Resposta pode vir em diferentes formatos dependendo da versão do nó\nif (inputData.message && inputData.message.content) {\n  sentimento = inputData.message.content.trim().toUpperCase();\n} else if (inputData.choices && inputData.choices[0]) {\n  sentimento = (inputData.choices[0].message?.content || inputData.choices[0].text || '').trim().toUpperCase();\n} else if (typeof inputData.text === 'string') {\n  sentimento = inputData.text.trim().toUpperCase();\n} else {\n  // Fallback: converte o objeto para string e tenta extrair\n  const raw = JSON.stringify(inputData);\n  if (raw.includes('POSITIVO')) sentimento = 'POSITIVO';\n  else if (raw.includes('NEGATIVO')) sentimento = 'NEGATIVO';\n  else sentimento = 'NEUTRO';\n}\n\n// Normaliza para garantir um dos três valores esperados\nif (!['POSITIVO', 'NEGATIVO', 'NEUTRO'].includes(sentimento)) {\n  if (sentimento.includes('POSITIV')) sentimento = 'POSITIVO';\n  else if (sentimento.includes('NEGATIV')) sentimento = 'NEGATIVO';\n  else sentimento = 'NEUTRO';\n}\n\n// Recupera o texto e email originais\nconst texto = $('Validar e preparar carga útil').first().json.texto;\nconst email_destino = $('Validar e preparar carga útil').first().json.email_destino;\n\nreturn [{\n  json: {\n    sentimento: sentimento,\n    texto: texto,\n    email_destino: email_destino,\n    is_positivo: sentimento === 'POSITIVO',\n    is_negativo: sentimento === 'NEGATIVO',\n    is_neutro: sentimento === 'NEUTRO'\n  }\n}];"
      },
